{
  "_comment": "Dixlase Deploy Configuration - Generated by: php artisan deploy:init",
  "_documentation": "See docs/deployment.md for full documentation",

  "global": {
    "sql_adapter": "mysql",
    "default_connection": "ssh"
  },

  "local": {
    "vhost": "http://localhost:8080",
    "dixlase_path": "/var/www/html",
    "database": {
      "name": "dixlase",
      "user": "root",
      "password": "password",
      "host": "localhost",
      "port": 3306
    }
  },

  "staging": {
    "vhost": "https://staging.example.com",
    "dixlase_path": "/var/www/staging",
    "database": {
      "name": "dixlase_staging",
      "user": "${STAGING_DB_USER}",
      "password": "${STAGING_DB_PASSWORD}",
      "host": "localhost",
      "port": 3306
    },
    "ssh": {
      "host": "staging.example.com",
      "user": "deploy",
      "port": 22,
      "key": "~/.ssh/id_rsa"
    },
    "exclude": [
      ".git/",
      ".gitignore",
      "node_modules/",
      "vendor/",
      ".env",
      ".env.*",
      "dixlase-deploy.json",
      "storage/logs/*",
      "storage/framework/cache/*",
      "storage/framework/sessions/*",
      "storage/framework/views/*",
      "bootstrap/cache/*",
      "*.sql",
      "*.sql.gz"
    ],
    "hooks": {
      "push": {
        "before": [
          {"command": "php artisan down", "where": "remote"}
        ],
        "after": [
          {"command": "php artisan migrate --force", "where": "remote"},
          {"command": "php artisan config:cache", "where": "remote"},
          {"command": "php artisan up", "where": "remote"}
        ]
      }
    }
  },

  "production": {
    "vhost": "https://example.com",
    "dixlase_path": "/var/www/production",
    "database": {
      "name": "dixlase_production",
      "user": "${PRODUCTION_DB_USER}",
      "password": "${PRODUCTION_DB_PASSWORD}",
      "host": "localhost",
      "port": 3306
    },
    "ssh": {
      "host": "example.com",
      "user": "deploy",
      "port": 22,
      "key": "~/.ssh/id_rsa"
    },
    "exclude": [
      ".git/",
      ".gitignore",
      "node_modules/",
      "vendor/",
      ".env",
      ".env.*",
      "dixlase-deploy.json",
      "storage/logs/*",
      "storage/framework/cache/*",
      "storage/framework/sessions/*",
      "storage/framework/views/*",
      "bootstrap/cache/*",
      "*.sql",
      "*.sql.gz"
    ],
    "hooks": {
      "push": {
        "before": [
          {"command": "php artisan down --secret=maintenance-bypass-token", "where": "remote"}
        ],
        "after": [
          {"command": "composer install --no-dev --optimize-autoloader", "where": "remote"},
          {"command": "php artisan migrate --force", "where": "remote"},
          {"command": "php artisan config:cache", "where": "remote"},
          {"command": "php artisan route:cache", "where": "remote"},
          {"command": "php artisan view:cache", "where": "remote"},
          {"command": "php artisan up", "where": "remote"}
        ]
      }
    }
  }
}
