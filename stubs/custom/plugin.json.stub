{
    "name": "{{ pluginName }}",
    "package_name": "{{ packageName }}",
    "slug": "{{ slug }}",
    "version": "1.0.0",
    "description": {
        "ja": "{{ pluginName }}のプラグインです。",
        "en": "This is the {{ pluginName }} plugin."
    },
    "author": "{{ author }}",
    "email": "{{ email }}",
    "url": "{{ url }}",
    "license": "{{ licenseName }}",
    "license_template": "{{ licenseTemplate }}",
    "namespace": "Plugins\\{{ pluginDirectory }}",
    "providers": [
        "Plugins\\{{ pluginDirectory }}\\App\\Providers\\{{ pluginDirectory }}ServiceProvider"
    ],
    "type": "dixlase-plugin",
    "category": "general",
    "tags": ["custom"],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "provides": {
        "admin_menu": false,
        "front_routes": false,
        "api_routes": false,
        "settings_page": false,
        "shortcodes": false,
        "helper_functions": false
    },
    "permissions": {
        "database": {
            "own_tables": false,
            "core_tables": []
        },
        "storage": {
            "own_directory": false,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": false,
            "write_own": true
        },
        "members": {
            "read": false,
            "write": false,
            "create": false,
            "delete": false
        },
        "mail": {
            "send": false,
            "bulk_send": false
        },
        "content": {
            "read_other_plugins": [],
            "write_other_plugins": []
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": false
        }
    },
    "signing": {
        "algo": "ed25519",
        "key_id": null
    }
}
