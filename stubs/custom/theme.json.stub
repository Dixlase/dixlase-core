{
    "name": "{{ themeName }}",
    "package_name": "{{ packageName }}",
    "slug": "{{ slug }}",
    "version": "1.0.0",
    "description": {
        "ja": "{{ themeName }}のテーマです。",
        "en": "This is the {{ themeName }} theme."
    },
    "author": "{{ author }}",
    "email": "{{ email }}",
    "url": "{{ url }}",
    "license": "{{ licenseName }}",
    "license_template": "{{ licenseTemplate }}",
    "namespace": "Themes\\{{ themeDirectory }}",
    "type": "dixlase-theme",
    "screenshot": "screenshot.png",
    "tags": ["custom", "modern"],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": false,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    }
}
