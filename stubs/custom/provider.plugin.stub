<?php

{{ license }}

namespace {{ namespace }};

use Illuminate\Support\ServiceProvider;
use Illuminate\Support\Facades\Route;

class {{ class }} extends ServiceProvider
{
    /**
     * Register services.
     */
    public function register(): void
    {
        // 設定ファイルをマージ
        $this->mergeConfigFrom(
            __DIR__ . '/../../config/{{ configFileName }}.php',
            '{{ configFileName }}'
        );
    }

    /**
     * Bootstrap services.
     */
    public function boot(): void
    {
        // ビューの登録
        $this->loadViewsFrom(__DIR__ . '/../../resources/views', '{{ pluginSlug }}');

        // 翻訳ファイルの登録
        $this->loadTranslationsFrom(__DIR__ . '/../../lang', '{{ pluginSlug }}');

        // マイグレーションの登録
        $this->loadMigrationsFrom(__DIR__ . '/../../database/migrations');

        // ルートの登録
        $this->registerRoutes();

        // 公開可能なアセット
        if ($this->app->runningInConsole()) {
            $this->publishes([
                __DIR__ . '/../../config/{{ configFileName }}.php' => config_path('{{ configFileName }}.php'),
            ], '{{ pluginSlug }}-config');

            $this->publishes([
                __DIR__ . '/../../resources/views' => resource_path('views/vendor/{{ pluginSlug }}'),
            ], '{{ pluginSlug }}-views');
        }
    }

    /**
     * ルートを登録
     */
    protected function registerRoutes(): void
    {
        // Web routes (フロントエンド)
        // IP制限を含む
        if (file_exists(__DIR__ . '/../../routes/web.php')) {
            Route::middleware(['web', 'front.ip'])
                ->group(__DIR__ . '/../../routes/web.php');
        }

        // Admin routes (管理画面)
        // IP制限、認証を含む
        if (file_exists(__DIR__ . '/../../routes/admin.php')) {
            Route::middleware(['web', 'auth:member', 'admin.ip'])
                ->prefix(config('admin.url', 'admin'))
                ->name('admin.')
                ->group(__DIR__ . '/../../routes/admin.php');
        }
    }
}
