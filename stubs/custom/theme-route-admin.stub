use Illuminate\Support\Facades\Route;
use {{ namespace }}\App\Http\Controllers\Admin\Settings\Themes\ThemeSettingsController;

// Admin routes for {{ themeDirectory }} theme settings
Route::middleware(['web', 'auth:admin'])->group(function () {
    Route::get('/admin/settings/themes/settings', [ThemeSettingsController::class, 'index'])->name('admin.settings.themes.{{ slug }}.settings');
    Route::post('/admin/settings/themes/settings', [ThemeSettingsController::class, 'update'])->name('admin.settings.themes.{{ slug }}.settings.update');
});
