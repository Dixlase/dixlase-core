{
    "name": "{{ softwareNameSlug }}/{{ pluginSlug }}",
    "description": "This is the {{ pluginName }} plugin.",
    "type": "dixlase-plugin",
    "version": "1.0.0",
    "license": "{{ licenseName }}",
    "authors": [
        {
            "name": "{{ author }}",
            "email": "{{ email }}",
            "homepage": "{{ url }}"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "autoload": {
        "psr-4": {
            "{{ vendorNameStudly }}\\{{ pluginNameStudly }}\\": ""
        }
    },
    "extra": {
        "display-name": "{{ pluginName }}",
        "keywords": ["dixlase", "plugin"],
        "slug": "{{ pluginSlug }}",
        "category": "general",
        "dixlase": {
            "providers": [
                "{{ vendorNameStudly }}\\{{ pluginNameStudly }}\\App\\Providers\\{{ pluginNameStudly }}ServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
