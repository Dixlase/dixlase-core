{
    "name": "{{ cmsNameSlug }}/plugins-{{ pluginSlug }}",
    "description": "This is the {{ pluginName }} plugin.",
    "version": "1.0.0",
    "license": "{{ licenseName }}",
    "authors": [
        {
            "name": "Your Name or Company",
            "email": "your-email@example.com",
            "homepage": "https://yourwebsite.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "some/dependency": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "{{ vendorNameStudly }}\\{{ pluginNameStudly }}\\App\\": "app/"
        }
    },
    "extra": {
        "display-name": "{{ pluginName }}",
        "keywords": ["laravel", "plugin", "custom"],
        "slug": "{{ slug }}",
        "category": "plugin",
        "laravel": {
            "providers": [
                "{{ vendorNameStudly }}\\{{ pluginNameStudly }}\\App\\Providers\\{{ pluginNameStudly }}ServiceProvider"
            ]
        }
    }
}
