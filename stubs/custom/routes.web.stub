use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| Web ルート
|--------------------------------------------------------------------------
|
| フロントエンド用のルートを登録するファイルです。
| これらのルートは RouteServiceProvider によって読み込まれ、
| "web" ミドルウェアグループに自動的に割り当てられます。
|
| セキュリティに関する注意:
| - front.ip ミドルウェアでIPアドレスフィルタリングを実施します
| - IPアドレスフィルタリングを実施しないとセキュリティリスクが高まります
|
*/

// フロントエンド用のルートグループ（IPフィルタリング付き）
Route::middleware(['front.ip'])
    ->group(function () {
        // フロントエンドのルートをここに定義します
    });