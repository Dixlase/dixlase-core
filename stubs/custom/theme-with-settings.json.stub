{
    "name": "{{ themeName }}",
    "package_name": "{{ packageName }}",
    "slug": "{{ slug }}",
    "version": "1.0.0",
    "description": {
        "ja": "{{ themeName }}のテーマです。",
        "en": "This is the {{ themeName }} theme."
    },
    "author": "{{ author }}",
    "email": "{{ email }}",
    "url": "{{ url }}",
    "license": "{{ licenseName }}",
    "license_template": "{{ licenseTemplate }}",
    "namespace": "Themes\\{{ themeDirectory }}",
    "type": "dixlase-theme",
    "screenshot": "screenshot.png",
    "tags": ["custom", "modern"],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": false,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    },
    "permissions": {
        "database": {
            "own_tables": true,
            "core_tables": []
        },
        "storage": {
            "own_directory": true,
            "public_uploads": false,
            "temp_files": false
        },
        "settings": {
            "read_core": false,
            "write_own": true
        },
        "assets": {
            "custom_css": true,
            "custom_js": true,
            "external_resources": false
        },
        "system": {
            "register_shortcodes": false,
            "register_middleware": false,
            "register_commands": false,
            "register_blade_directives": false,
            "modify_routes": true
        }
    }
}
