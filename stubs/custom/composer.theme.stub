{
    "name": "{{ packageName }}",
    "description": "This is the {{ themeName }} theme.",
    "type": "dixlase-theme",
    "license": "{{ licenseName }}",
    "authors": [
        {
            "name": "{{ author }}",
            "email": "{{ email }}",
            "homepage": "{{ url }}"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "{{ namespace }}\\": "app/"
        }
    },
    "extra": {
        "dixlase": {
            "type": "theme",
            "slug": "{{ slug }}",
            "display-name": "{{ themeName }}",
            "version": "{{ version }}"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
