{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "google/cloud-recaptcha-enterprise": "^2.1",
        "laragear/webauthn": "^4.0",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.0",
        "laravel/breeze": "^2.2",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Custom\\App\\": "custom/app/",
            "Custom\\Database\\Factories\\": "custom/database/factories",
            "Custom\\Database\\Seeders\\": "custom/database/seeders",
            "Plugins\\DixlaseInquiry\\App\\": "plugins/DixlaseInquiry/app",
            "Plugins\\DixlaseInquiry\\Database\\Factories\\": "plugins/DixlaseInquiry/database/factories",
            "Plugins\\DixlaseInquiry\\Database\\Seeders\\": "plugins/DixlaseInquiry/database/seeders",
            "Plugins\\DixlasePages\\App\\": "plugins/DixlasePages/app",
            "Plugins\\DixlasePages\\Database\\Factories\\": "plugins/DixlasePages/database/factories",
            "Plugins\\DixlasePages\\Database\\Seeders\\": "plugins/DixlasePages/database/seeders",
            "Plugins\\DixlaseBlog\\App\\": "plugins/DixlaseBlog/app",
            "Plugins\\DixlaseBlog\\Database\\Factories\\": "plugins/DixlaseBlog/database/factories",
            "Plugins\\DixlaseBlog\\Database\\Seeders\\": "plugins/DixlaseBlog/database/seeders",
            "Plugins\\DixlaseUsers\\App\\": "plugins/DixlaseUsers/app",
            "Plugins\\DixlaseUsers\\Database\\Factories\\": "plugins/DixlaseUsers/database/factories",
            "Plugins\\DixlaseUsers\\Database\\Seeders\\": "plugins/DixlaseUsers/database/seeders"
        },
        "files": [
            "app/Helpers/AssetHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Custom\\Tests\\": "custom/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}