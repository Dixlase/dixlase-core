{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/breeze": "^2.2",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Database\\Seeders\\Dev\\": "database/seeders/dev",
            "Database\\Seeders\\Pro\\": "database/seeders/pro",
            "Custom\\App\\": "custom/app",
            "Custom\\Database\\Factories\\": "custom/database/factories",
            "Custom\\Database\\Seeders\\": "custom/database/seeders",
            "Custom\\Database\\Seeders\\Dev\\": "custom/database/seeders/dev",
            "Custom\\Database\\Seeders\\Pro\\": "custom/database/seeders/pro",
            "Plugins\\ReservationsPlugin\\App\\": "plugins/ReservationsPlugin/app",
            "Plugins\\ReservationsPlugin\\Database\\Factories\\": "plugins/ReservationsPlugin/database/factories",
            "Plugins\\ReservationsPlugin\\Database\\Seeders\\": "plugins/ReservationsPlugin/database/seeders",
            "Plugins\\ReservationsPlugin\\Database\\Seeders\\Dev\\": "plugins/ReservationsPlugin/database/seeders/dev",
            "Plugins\\ReservationsPlugin\\Database\\Seeders\\Pro\\": "plugins/ReservationsPlugin/database/seeders/pro",
            "Plugins\\UsersPlugin\\App\\": "plugins/UsersPlugin/app",
            "Plugins\\UsersPlugin\\Database\\Factories\\": "plugins/UsersPlugin/database/factories",
            "Plugins\\UsersPlugin\\Database\\Seeders\\": "plugins/UsersPlugin/database/seeders",
            "Plugins\\UsersPlugin\\Database\\Seeders\\Dev\\": "plugins/UsersPlugin/database/seeders/dev",
            "Plugins\\UsersPlugin\\Database\\Seeders\\Pro\\": "plugins/UsersPlugin/database/seeders/pro",
            "Plugins\\EventsPlugin copy\\App\\": "plugins/EventsPlugin copy/app",
            "Plugins\\EventsPlugin copy\\Database\\Factories\\": "plugins/EventsPlugin copy/database/factories",
            "Plugins\\EventsPlugin copy\\Database\\Seeders\\": "plugins/EventsPlugin copy/database/seeders",
            "Plugins\\EventsPlugin copy\\Database\\Seeders\\Dev\\": "plugins/EventsPlugin copy/database/seeders/dev",
            "Plugins\\EventsPlugin copy\\Database\\Seeders\\Pro\\": "plugins/EventsPlugin copy/database/seeders/pro",
            "Plugins\\PagesPlugin\\App\\": "plugins/PagesPlugin/app",
            "Plugins\\PagesPlugin\\Database\\Factories\\": "plugins/PagesPlugin/database/factories",
            "Plugins\\PagesPlugin\\Database\\Seeders\\": "plugins/PagesPlugin/database/seeders",
            "Plugins\\PagesPlugin\\Database\\Seeders\\Dev\\": "plugins/PagesPlugin/database/seeders/dev",
            "Plugins\\PagesPlugin\\Database\\Seeders\\Pro\\": "plugins/PagesPlugin/database/seeders/pro",
            "Plugins\\EventsPlugin\\App\\": "plugins/EventsPlugin/app",
            "Plugins\\EventsPlugin\\Database\\Seeders\\": "plugins/EventsPlugin/database/seeders",
            "Plugins\\EventsPlugin\\Database\\Seeders\\Dev\\": "plugins/EventsPlugin/database/seeders/dev",
            "Plugins\\EventsPlugin\\Database\\Seeders\\Pro\\": "plugins/EventsPlugin/database/seeders/pro",
            "Plugins\\EventsPlugin\\Database\\Factories\\": "plugins/EventsPlugin/database/factories",
            "Plugins\\BlogPlugin\\App\\": "plugins/BlogPlugin/app",
            "Plugins\\BlogPlugin\\Database\\Factories\\": "plugins/BlogPlugin/database/factories",
            "Plugins\\BlogPlugin\\Database\\Seeders\\": "plugins/BlogPlugin/database/seeders",
            "Plugins\\BlogPlugin\\Database\\Seeders\\Dev\\": "plugins/BlogPlugin/database/seeders/dev",
            "Plugins\\BlogPlugin\\Database\\Seeders\\Pro\\": "plugins/BlogPlugin/database/seeders/pro",
            "Plugins\\MyPlugin\\App\\": "plugins/MyPlugin/app",
            "Plugins\\MyPlugin\\Database\\Factories\\": "plugins/MyPlugin/database/factories",
            "Plugins\\MyPlugin\\Database\\Seeders\\": "plugins/MyPlugin/database/seeders",
            "Plugins\\MyPlugin\\Database\\Seeders\\Dev\\": "plugins/MyPlugin/database/seeders/dev",
            "Plugins\\MyPlugin\\Database\\Seeders\\Pro\\": "plugins/MyPlugin/database/seeders/pro"
        },
        "files": [
            "app/Helpers/AssetHelper.php",
            "app/Helpers/AdminHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Custom\\Tests\\": "custom/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
