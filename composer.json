{
    "name": "dixlase/dixlase-core",
    "type": "project",
    "description": "Dixlase — plugin-driven Laravel CMS.",
    "keywords": [
        "dixlase",
        "cms",
        "laravel"
    ],
    "license": "AGPL-3.0-only OR LicenseRef-Dixlase-Commercial",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Dixlase/theme-dixlase-onepage"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer/installers": "^2.0",
        "composer/semver": "^3.4",
        "dixlase/dixlase-onepage": "dev-main@dev",
        "google/cloud-recaptcha-enterprise": "^2.1",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^13.0",
        "laravel/passkeys": "^0.2.1",
        "laravel/tinker": "^3.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.0",
        "laravel/breeze": "^2.2",
        "laravel/mcp": "^1.0",
        "laravel/pint": "1.26.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Custom\\App\\": "custom/app/",
            "Custom\\Database\\Factories\\": "custom/database/factories",
            "Custom\\Database\\Seeders\\": "custom/database/seeders"
        },
        "files": [
            "app/Helpers/AssetHelper.php",
            "app/Helpers/GlobalHelper.php",
            "app/Helpers/PluginPermissionHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Custom\\Tests\\": "custom/tests/"
        }
    },
    "scripts": {
        "pre-autoload-dump": [
            "@php scripts/sync-local-autoload.php"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php scripts/post-create-message.php"
        ],
        "test": "php artisan test",
        "test:coverage": "php artisan test --coverage",
        "lint": "./vendor/bin/pint",
        "lint:check": "./vendor/bin/pint --test",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": false,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        },
        "laravel": {
            "dont-discover": []
        },
        "installer-types": [
            "dixlase-theme"
        ],
        "installer-paths": {
            "themes/DixlaseOnePage/": ["dixlase/dixlase-onepage"]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "audit": {
            "abandoned": "report"
        },
        "allow-plugins": {
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
