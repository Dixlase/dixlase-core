{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "cweagans/composer-patches": "^2.0",
        "google/cloud-recaptcha-enterprise": "^2.1",
        "laragear/webauthn": "^4.0",
        "laravel/fortify": "^1.25",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^4.1",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^2.0",
        "laravel/breeze": "^2.2",
        "laravel/pint": "^1.13",
        "larastan/larastan": "^3.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Custom\\App\\": "custom/app/",
            "Custom\\Database\\Factories\\": "custom/database/factories",
            "Custom\\Database\\Seeders\\": "custom/database/seeders",
            "Plugins\\": "plugins/",
            "Plugins\\DixlaseAi\\App\\": "plugins/DixlaseAi/app/",
            "Plugins\\DixlaseAuthority\\App\\": "plugins/DixlaseAuthority/app/",
            "Plugins\\DixlaseAuthority\\Database\\": "plugins/DixlaseAuthority/database/",
            "Plugins\\DixlaseBackup\\App\\": "plugins/DixlaseBackup/app/",
            "Plugins\\DixlaseBackup\\Database\\": "plugins/DixlaseBackup/database/",
            "Plugins\\DixlaseBlog\\App\\": "plugins/DixlaseBlog/app/",
            "Plugins\\DixlaseBlog\\Database\\": "plugins/DixlaseBlog/database/",
            "Plugins\\DixlaseCoreDevKit\\App\\": "plugins/DixlaseCoreDevKit/app/",
            "Plugins\\DixlaseCoreDevKit\\Database\\": "plugins/DixlaseCoreDevKit/database/",
            "Plugins\\DixlaseDeploy\\App\\": "plugins/DixlaseDeploy/app/",
            "Plugins\\DixlaseDeploy\\Database\\": "plugins/DixlaseDeploy/database/",
            "Plugins\\DixlaseDevKit\\App\\": "plugins/DixlaseDevKit/app/",
            "Plugins\\DixlaseDevKit\\Database\\": "plugins/DixlaseDevKit/database/",
            "Plugins\\DixlaseGUIEditorLite\\App\\": "plugins/DixlaseGUIEditorLite/app/",
            "Plugins\\DixlaseGUIEditorLite\\Database\\": "plugins/DixlaseGUIEditorLite/database/",
            "Plugins\\DixlaseInquiry\\App\\": "plugins/DixlaseInquiry/app/",
            "Plugins\\DixlaseInquiry\\Database\\": "plugins/DixlaseInquiry/database/",
            "Plugins\\DixlaseLegal\\App\\": "plugins/DixlaseLegal/app/",
            "Plugins\\DixlaseLegal\\Database\\": "plugins/DixlaseLegal/database/",
            "Plugins\\DixlaseMenus\\App\\": "plugins/DixlaseMenus/app/",
            "Plugins\\DixlaseMenus\\Database\\": "plugins/DixlaseMenus/database/",
            "Plugins\\DixlaseMultilingual\\App\\": "plugins/DixlaseMultilingual/app/",
            "Plugins\\DixlaseMultilingual\\Database\\": "plugins/DixlaseMultilingual/database/",
            "Plugins\\DixlaseOfficialDocs\\App\\": "plugins/DixlaseOfficialDocs/app/",
            "Plugins\\DixlaseOfficialDocs\\Database\\": "plugins/DixlaseOfficialDocs/database/",
            "Plugins\\DixlasePages\\App\\": "plugins/DixlasePages/app/",
            "Plugins\\DixlasePages\\Database\\": "plugins/DixlasePages/database/",
            "Plugins\\DixlaseSEO\\App\\": "plugins/DixlaseSEO/app/",
            "Plugins\\DixlaseSEO\\Database\\": "plugins/DixlaseSEO/database/",
            "Plugins\\DixlaseUsers\\App\\": "plugins/DixlaseUsers/app/",
            "Plugins\\DixlaseUsers\\Database\\": "plugins/DixlaseUsers/database/",
            "Themes\\DixlaseOnePage\\App\\": "themes/DixlaseOnePage/app/",
            "Themes\\DixlaseOnePage\\Database\\": "themes/DixlaseOnePage/database/"
        },
        "files": [
            "app/Helpers/AssetHelper.php",
            "app/Helpers/GlobalHelper.php",
            "app/Helpers/PluginPermissionHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Custom\\Tests\\": "custom/tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test": "php artisan test",
        "test:coverage": "php artisan test --coverage",
        "lint": "./vendor/bin/pint",
        "lint:check": "./vendor/bin/pint --test",
        "analyse": "./vendor/bin/phpstan analyse --memory-limit=2G"
    },
    "extra": {
        "merge-plugin": {
            "include": [
                "composer.local.json"
            ],
            "recurse": false,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": false
        },
        "laravel": {
            "dont-discover": []
        },
        "patches": {
            "laragear/webauthn": [
                "patches/laragear-webauthn-disable-public-key-encryption.patch"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "wikimedia/composer-merge-plugin": true,
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
