{
    "name": "Dixlase Default Theme",
    "slug": "dixlase-default-theme",
    "version": "1.0.0",
    "description": {
        "ja": "Dixlaseのデフォルトテーマ。シンプルでモダンなデザイン。",
        "en": "Default theme for Dixlase. Simple and modern design."
    },
    "author": "exc-D inc.",
    "author_url": "https://exc-d.com",
    "license": "AGPL-3.0-or-later",
    "license_url": "https://www.gnu.org/licenses/agpl-3.0.html",
    "screenshot": "screenshot.png",
    "tags": ["default", "simple", "modern", "responsive"],
    "requires": {
        "dixlase": ">=1.0.0",
        "php": ">=8.2"
    },
    "supports": {
        "dark_mode": true,
        "responsive": true,
        "front_page_builder": true,
        "custom_colors": true
    },
    "customizable": {
        "colors": {
            "primary": "#3b82f6",
            "secondary": "#6b7280",
            "accent": "#10b981"
        },
        "fonts": {
            "body": "system-ui, -apple-system, sans-serif",
            "heading": "system-ui, -apple-system, sans-serif"
        }
    }
