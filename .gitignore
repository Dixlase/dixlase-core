# Localized JA reference files (generated; primary repo content is English).
# Templates inside plugins/**, themes/**, .claude/** are kept as sources for
# the generators in DixlaseCoreDevKit (governance, readme, plugin-api).
#
# Exception: legal documents (Copyright Policy, Contributor License
# Agreements) are tracked in BOTH languages because the Japanese version
# is legally authoritative ("the Japanese version shall prevail" clause)
# and must be auditable via git history and PR diffs. LICENSE / LICENSE-ja /
# LICENSE.commercial / LICENSE.commercial-ja have no .md suffix and are
# not matched by this pattern.
*.ja.md
!plugins/**/*.ja.md
!themes/**/*.ja.md
!.claude/**/*.ja.md
!COPYRIGHT-POLICY.ja.md
!CLA-INDIVIDUAL.ja.md
!CLA-CORPORATE.ja.md

# Dixlase カスタム
# カスタムファイルを入れるディレクトリを除外
custom/*

# プラグインとテーマのディレクトリを除外
# プラグイン: 個別のリポジトリとして管理（.git/info/excludeで追跡）
# テーマ: DixlaseOnePageはGit Submoduleとしてコアに同梱
plugins/*
!plugins/DixlaseInquiry/
!plugins/DixlaseLegal/
!plugins/DixlaseMenus/
!plugins/DixlasePages/
!plugins/DixlaseSEO/
!plugins/DixlaseSigner/
!plugins/DixlaseUsers/
!plugins/DixlaseDevKit/
!plugins/DixlaseCoreDevKit/
!plugins/DixlaseAuthority/
themes/*
!themes/DixlaseOnePage/

license-info.json
license.txt

# IDE / MCP / AI assistant configs
.junie/
.cursor/
.claude/
.vscode/mcp.json
.mcp.json
*.bak

# AI guidelines (generated by dls:claude:setup core)
.ai/guidelines/

