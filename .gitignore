# Localized JA reference files (generated; primary repo content is English).
# Templates inside plugins/**, themes/**, .claude/** are kept as sources for
# the generators in DixlaseCoreDevKit (governance, readme, plugin-api).
#
# Exceptions tracked in both languages:
#  - Legal documents (Copyright Policy, Contributor License Agreements) —
#    Japanese is legally authoritative ("the Japanese version shall prevail"
#    clause) and must be auditable via git history and PR diffs.
#  - Contribution-policy documents (Contributing Guide, Future Contribution
#    Flow) — they carry the externally-visible deferral statement that gates
#    PR acceptance until the CLA's formal legal review is complete; the JA
#    audience needs to read this without running the generator locally.
# LICENSE / LICENSE-ja / LICENSE.commercial / LICENSE.commercial-ja have no
# .md suffix and are not matched by this pattern.
*.ja.md
!plugins/**/*.ja.md
!themes/**/*.ja.md
!.claude/**/*.ja.md
!COPYRIGHT-POLICY.ja.md
!CLA.ja.md
!CONTRIBUTING.ja.md
!CONTRIBUTING-FUTURE.ja.md
!TRADEMARK-POLICY.ja.md
!README.ja.md
!SECURITY.ja.md

# Dixlase カスタム
# カスタムファイルを入れるディレクトリを除外
custom/*

# プラグインとテーマのディレクトリを除外
# プラグイン: 個別のリポジトリとして管理（.git/info/excludeで追跡）
# テーマ: DixlaseOnePage は composer/installers 経由で
#   themes/DixlaseOnePage/ に展開される vendor 管理ディレクトリで、
#   Core の git では tracking しない（b451bc75 で Submodule → Composer
#   依存に移行）。
plugins/*
!plugins/DixlaseInquiry/
!plugins/DixlaseLegal/
!plugins/DixlaseMenus/
!plugins/DixlaseOfficialDocs/
!plugins/DixlasePages/
!plugins/DixlaseRedirects/
!plugins/DixlaseSEO/
!plugins/DixlaseSigner/
!plugins/DixlaseUsers/
!plugins/DixlaseDevKit/
!plugins/DixlaseCoreDevKit/
!plugins/DixlaseAuthority/
themes/*

license-info.json
license.txt

# IDE / MCP / AI assistant configs
.junie/
.cursor/
.claude/
.vscode/mcp.json
.mcp.json
*.bak

# AI guidelines (generated by dls:claude:setup core)
.ai/guidelines/

# Maintainer-only backlog: deferred items, audit results, future-version plans
# (see .backlog/README.md for what belongs here)
/.backlog/

# Sandbox tests: throw-away test files used by Claude Code during coding
# tasks. Excluded from CI/CD test suites. See CLAUDE.md "Sandbox Tests".
/tests/Sandbox/

# Test runner leftover: storage_path() resolves to <project>/var/www/html/storage
# under certain phpunit configurations, leaving an empty var/ tree behind.
/var/

# Auto-generated Tailwind plugin-source aggregator. Written by
# App\Services\Tailwind\PluginSourceAggregator on every plugin lifecycle
# event and at install time — never hand-edited, never committed.
/resources/src/common/css/dixlase-tailwind-plugin-sources.css

