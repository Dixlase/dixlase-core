/.fleet
/.idea
/.vscode
/.zed
DS_Store
CLAUDE.md

# Dixlase カスタム
# カスタムファイルを入れるディレクトリを除外
custom/*
# プラグインを入れるディレクトリを除外
plugins/*
!plugins/DixlasePages
!plugins/DixlaseInquiry
# === プラグイン用動的除外設定 (自動管理) ===
# 以下の行はプラグインシステムによって自動管理されます
!plugins/DixlaseInquiry/
# === プラグイン用動的除外設定終了 ===
# テーマを入れるディレクトリを除外
themes/*
# ただしデフォルトテーマはコアに含める
!themes/DixlaseDefaultTheme/
license-info.json
license.txt

