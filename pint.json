{
    "preset": "laravel",
    "rules": {
        "simplified_null_return": true,
        "braces": {
            "allow_single_line_closure": true
        },
        "new_with_braces": {
            "anonymous_class": false,
            "named_class": true
        }
    },
    "exclude": [
        "bootstrap/cache",
        "storage",
        "vendor",
        "node_modules",
        "plugins/*/vendor"
    ]
}