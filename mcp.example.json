{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "-p",
                "your-project-name",
                "-f",
                "/absolute/path/to/docker-compose.yml",
                "exec",
                "-T",
                "-w",
                "/var/www/html",
                "laravel.test",
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}