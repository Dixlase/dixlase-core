SOFTWARE_NAME=Dixlase
APP_NAME=Dixlase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
#APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=dixlase,notification
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=dixlase
DB_USERNAME=dixlase
DB_PASSWORD=dixlase
DB_PREFIX=dls_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

#管理画面の設定
CUSTOM_FILES_DIR=custom
DEFAULT_MERGE_MODE=replace

#二段階認証の設定
TWO_FACTOR_CODE_EXPIRE=5
TWO_FACTOR_RESEND_INTERVAL=60
TWO_FACTOR_DEVICE_EXPIRE_DAYS=30

# 拡張機能GitHubトークン（オプション）
EXTENSION_GITHUB_TOKEN=

#テーマの設定
APP_THEME=DixlaseOnePage

#メンテナンスモード
#MAINTENANCE_MODE=false

# インストール済みフラグ
INSTALLED=false

# AGPL §13 準拠: 運用中の Dixlase CMS のソースコード取得先 URL
# 改変版を運用する場合は、自身のリポジトリ URL に差し替えること
DIXLASE_SOURCE_URL=https://github.com/Dixlase/dixlase-core

# Trusted reverse proxies / IAP upstreams.
# Comma-separated list of IPs or CIDR ranges. Default unset = no proxies
# trusted; $request->ip() returns the TCP source IP and X-Forwarded-* headers
# are ignored. Operators running Dixlase behind a CDN, reverse proxy, or
# Identity-Aware Proxy (Cloudflare, Cloudfront, Traefik, Google IAP, …) must
# set this so admin IP allow-lists and HTTPS detection work correctly.
# Use '*' only in development/closed networks — it disables forwarded-header
# authenticity. See SECURITY.md "Reverse-proxy / IAP deployment".
# Examples:
#   TRUSTED_PROXIES=10.0.0.0/8
#   TRUSTED_PROXIES=173.245.48.0/20,103.21.244.0/22,103.22.200.0/22
#TRUSTED_PROXIES=

# HTTP Strict Transport Security (HSTS) posture.
# Conservative defaults: HSTS is OFF (max-age=0). Once a browser caches an
# HSTS directive it cannot be revoked from the server side until max-age
# expires — mistakes cause multi-day recovery windows. Recommended escalation
# path (see SECURITY.md "HSTS posture"):
#   1. Beta / first deploy:   HSTS_MAX_AGE=0       (off)
#   2. After HTTPS proven:    HSTS_MAX_AGE=300     (5 min — recoverable)
#   3. After ~1 day stable:   HSTS_MAX_AGE=86400   (1 day)
#   4. Mature production:     HSTS_MAX_AGE=31536000 (1 year)
#   5. Then enable:           HSTS_INCLUDE_SUBDOMAINS=true
#   6. Last (irreversible):   HSTS_PRELOAD=true and submit to hstspreload.org
HSTS_MAX_AGE=0
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false