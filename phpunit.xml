<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</exclude>
            <exclude>tests/Unit/Admin/Users/AdminUserUnitTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Custom">
            <!-- カスタムオーバーライドのテスト（custom/ が存在する環境のみ） -->
            <directory>custom/tests/Unit</directory>
            <directory>custom/tests/Feature</directory>
            <file>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</file>
        </testsuite>
        <!-- ============================================ -->
        <!-- プラグインテストスイート（個別）              -->
        <!-- ============================================ -->
        <testsuite name="DixlaseOfficialDocs">
            <directory>plugins/DixlaseOfficialDocs/tests</directory>
        </testsuite>
        <testsuite name="DixlaseDevKit">
            <directory>plugins/DixlaseDevKit/tests</directory>
        </testsuite>
        <testsuite name="DixlaseCoreDevKit">
            <directory>plugins/DixlaseCoreDevKit/tests</directory>
        </testsuite>
        <testsuite name="DixlaseLegal">
            <directory>plugins/DixlaseLegal/tests</directory>
        </testsuite>
        <testsuite name="DixlaseInquiry">
            <directory>plugins/DixlaseInquiry/tests</directory>
        </testsuite>
        <testsuite name="DixlaseSEO">
            <directory>plugins/DixlaseSEO/tests</directory>
        </testsuite>
        <testsuite name="DixlaseMenus">
            <directory>plugins/DixlaseMenus/tests</directory>
        </testsuite>
        <testsuite name="DixlasePages">
            <directory>plugins/DixlasePages/tests</directory>
        </testsuite>
        <testsuite name="DixlaseAi">
            <directory>plugins/DixlaseAi/tests</directory>
        </testsuite>
        <testsuite name="DixlaseUsers">
            <directory>plugins/DixlaseUsers/tests</directory>
        </testsuite>
        <testsuite name="DixlaseAuthority">
            <directory>plugins/DixlaseAuthority/tests</directory>
        </testsuite>
        <testsuite name="DixlaseRedirects">
            <directory>plugins/DixlaseRedirects/tests</directory>
        </testsuite>
        <testsuite name="DixlaseSigner">
            <directory>plugins/DixlaseSigner/tests</directory>
        </testsuite>
        <!-- プラグインテストスイート（一括実行用） -->
        <!-- Usage: php artisan test testsuite=Plugins    -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>
        <!-- ============================================ -->
        <!-- テーマテストスイート(一括・glob で展開)         -->
        <!-- Glob: empty when no theme has tests/, so it    -->
        <!-- never errors in environments that lack themes. -->
        <!-- ============================================ -->
        <testsuite name="Themes">
            <directory>themes/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" makes phpunit OVERWRITE values already present in   -->
        <!-- the process env (i.e. .env / docker compose env_file). Without   -->
        <!-- it, a stray DB_CONNECTION=mysql in .env would survive into the   -->
        <!-- test run and RefreshDatabase would migrate:fresh the real DB.    -->
        <!-- The TestCase MySQL guard is a second-line defence — both must   -->
        <!-- be present to fail safe.                                        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="FORCE_SSL" value="false" force="true"/>
        <env name="INSTALLED" value="false" force="true"/>
    </php>
</phpunit>
