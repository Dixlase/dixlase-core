<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Custom">
            <!-- カスタムオーバーライドのテスト（custom/ が存在する環境のみ） -->
            <directory>custom/tests/Unit</directory>
            <directory>custom/tests/Feature</directory>
            <file>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</file>
        </testsuite>
        <!-- ============================================ -->
        <!-- プラグインテストスイート（個別）              -->
        <!-- ============================================ -->
        <testsuite name="DixlaseOfficialDocs">
            <directory>plugins/DixlaseOfficialDocs/tests</directory>
        </testsuite>
        <testsuite name="DixlaseDevKit">
            <directory>plugins/DixlaseDevKit/tests</directory>
        </testsuite>
        <testsuite name="DixlaseCoreDevKit">
            <directory>plugins/DixlaseCoreDevKit/tests</directory>
        </testsuite>
        <testsuite name="DixlaseLegal">
            <directory>plugins/DixlaseLegal/tests</directory>
        </testsuite>
        <testsuite name="DixlaseInquiry">
            <directory>plugins/DixlaseInquiry/tests</directory>
        </testsuite>
        <testsuite name="DixlaseSEO">
            <directory>plugins/DixlaseSEO/tests</directory>
        </testsuite>
        <testsuite name="DixlaseMenus">
            <directory>plugins/DixlaseMenus/tests</directory>
        </testsuite>
        <testsuite name="DixlasePages">
            <directory>plugins/DixlasePages/tests</directory>
        </testsuite>
        <testsuite name="DixlaseGUIEditorLite">
            <directory>plugins/DixlaseGUIEditorLite/tests</directory>
        </testsuite>
        <testsuite name="DixlaseAi">
            <directory>plugins/DixlaseAi/tests</directory>
        </testsuite>
        <testsuite name="DixlaseUsers">
            <directory>plugins/DixlaseUsers/tests</directory>
        </testsuite>
        <testsuite name="DixlaseAuthority">
            <directory>plugins/DixlaseAuthority/tests</directory>
        </testsuite>
        <testsuite name="DixlaseBackup">
            <directory>plugins/DixlaseBackup/tests</directory>
        </testsuite>
        <testsuite name="DixlaseDeploy">
            <directory>plugins/DixlaseDeploy/tests</directory>
        </testsuite>
        <testsuite name="DixlaseMultilingual">
            <directory>plugins/DixlaseMultilingual/tests</directory>
        </testsuite>
        <!-- プラグインテストスイート（一括実行用） -->
        <!-- Usage: php artisan test testsuite=Plugins    -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="FORCE_SSL" value="false"/>
        <env name="INSTALLED" value="false"/>
    </php>
</phpunit>
