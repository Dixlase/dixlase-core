<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <exclude>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</exclude>
            <exclude>tests/Unit/Admin/Users/AdminUserUnitTest.php</exclude>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Custom">
            <!-- カスタムオーバーライドのテスト（custom/ が存在する環境のみ） -->
            <directory>custom/tests/Unit</directory>
            <directory>custom/tests/Feature</directory>
            <file>tests/Unit/Traits/CustomFilesLoaderTraitTest.php</file>
        </testsuite>
        <!-- ============================================ -->
        <!-- Per-extension suites                           -->
        <!--                                                -->
        <!-- Only the extensions this repository            -->
        <!-- distributes publicly are named here. The rest  -->
        <!-- are added to the runner's copy of this file by -->
        <!-- .github/scripts/fetch-integration-plugins.sh,  -->
        <!-- from a repository variable (dixlase-core#619),  -->
        <!-- so a reader is not shown the names and the      -->
        <!-- directory layout of software they cannot get.  -->
        <!--                                                -->
        <!-- On a machine that has them, "Plugins" below    -->
        <!-- already covers every extension present, so     -->
        <!-- nothing has to be added here to run them.      -->
        <!--                                                -->
        <!-- Every suite named here has to resolve to a     -->
        <!-- directory that is always present. PHPUnit      -->
        <!-- validates each suite named on the command line -->
        <!-- before it runs any of them, so one absent      -->
        <!-- directory ends the run with exit 2 and nothing -->
        <!-- executes (dixlase-core#658). An extension that -->
        <!-- is not always on disk belongs in the run-time  -->
        <!-- rows, not here.                                -->
        <!-- ============================================ -->
        <testsuite name="DixlaseInquiry">
            <directory>plugins/DixlaseInquiry/tests</directory>
        </testsuite>
        <testsuite name="DixlaseSEO">
            <directory>plugins/DixlaseSEO/tests</directory>
        </testsuite>
        <testsuite name="DixlaseMenus">
            <directory>plugins/DixlaseMenus/tests</directory>
        </testsuite>
        <testsuite name="DixlasePages">
            <directory>plugins/DixlasePages/tests</directory>
        </testsuite>
        <testsuite name="DixlaseBlog">
            <directory>plugins/DixlaseBlog/tests</directory>
        </testsuite>
        <!-- Every extension present, in one suite -->
        <!-- Usage: php artisan test testsuite=Plugins   -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>
        <!-- ============================================ -->
        <!-- テーマテストスイート(一括・glob で展開)         -->
        <!-- Glob: empty when no theme has tests/, so it    -->
        <!-- never errors in environments that lack themes. -->
        <!-- ============================================ -->
        <testsuite name="Themes">
            <directory>themes/*/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- force="true" makes phpunit overwrite a value .env would       -->
        <!-- otherwise supply: Dotenv is immutable and skips a key that is   -->
        <!-- already set, so without it a DB_CONNECTION=mysql in .env would  -->
        <!-- survive into the run and RefreshDatabase would rebuild the      -->
        <!-- real database from scratch.                                     -->
        <!--                                                                 -->
        <!-- What it cannot do: override a REAL process environment          -->
        <!-- variable. phpunit writes putenv() and $_ENV; Laravel's env()    -->
        <!-- reads $_SERVER first, and the CLI SAPI fills $_SERVER from the  -->
        <!-- process environment. So an exported DB_CONNECTION, a            -->
        <!-- container's environment: block or a CI step's env: beats every  -->
        <!-- line below, silently (#541). The two guards in tests/TestCase   -->
        <!-- are what catch that: one before the app boots, one on the       -->
        <!-- booted config. CI runs against MySQL on purpose and opts in     -->
        <!-- with DLS_TESTS_ALLOW_NON_SQLITE=1; see                          -->
        <!-- docs/development/test-database.md.                              -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="FORCE_SSL" value="false" force="true"/>
        <env name="INSTALLED" value="false" force="true"/>
    </php>
</phpunit>
